      localSlotModes[idx]=mode;syncSlotsToSelects();renderLocalPlayerGrid();saveGameCreationPrefs();
    }));
    grid.querySelectorAll('.slot-toggle').forEach(btn=>btn.addEventListener('click',e=>{
      e.stopPropagation();
      const idx=+btn.closest('.classic-player-card').dataset.slot,was=localSlotModes[idx];
