<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
  <meta name="theme-color" content="#0b1014">
  <title>Tank Wars 2.5</title>
  <style>
    :root{
      --ink:#f4e9c8;--muted:#9da594;--amber:#f4d35e;--orange:#ff9f1c;--red:#ee6352;
      --green:#59cd90;--blue:#3fa7d6;--panel:#111a1f;--edge:#3a4a48;--black:#070a0c;
      --shadow:rgba(0,0,0,.6)
    }
    *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
    html,body{width:100%;height:100%;margin:0;overflow:hidden;background:#050708;color:var(--ink);font-family:"Courier New",monospace;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
    #shell,.screen,canvas{ -webkit-user-select:none!important;user-select:none!important;-webkit-touch-callout:none!important }
    button,input,select{font:inherit}
    button{touch-action:manipulation}
    #shell{position:fixed;left:50%;top:50%;width:1280px;height:720px;transform:translate(-50%,-50%);transform-origin:center;background:#0b1014;overflow:hidden;box-shadow:0 0 80px #000}
    #shell:after{content:"";position:absolute;inset:0;z-index:999;pointer-events:none;opacity:.16;background:repeating-linear-gradient(0deg,transparent 0 3px,rgba(0,0,0,.34) 4px)}
    .screen{position:absolute;inset:0;display:none;z-index:5;background:
      radial-gradient(circle at 78% 20%,rgba(244,211,94,.09),transparent 28%),
      linear-gradient(135deg,#10191d,#080c0e 70%)}
    .screen.active{display:block}
    .screen-scroll{height:100%;overflow:auto;padding:34px 54px 40px;scrollbar-width:thin;scrollbar-color:var(--amber) #111}
    .eyebrow{color:var(--amber);font-size:13px;letter-spacing:4px;text-transform:uppercase;margin-bottom:8px}
    h1,h2,h3,p{margin-top:0}
    h1{font-size:72px;line-height:.88;letter-spacing:-5px;margin-bottom:14px;text-shadow:5px 5px 0 #522d1b;color:#f7e8b2}
    h2{font-size:38px;letter-spacing:2px;margin-bottom:6px}
    h3{font-size:18px;color:var(--amber);letter-spacing:2px}
    .subtitle{color:var(--muted);letter-spacing:2px;font-size:14px;line-height:1.5}
    .rule{height:2px;background:linear-gradient(90deg,var(--amber),transparent);margin:20px 0}
    .panel{background:rgba(15,23,27,.94);border:2px solid var(--edge);box-shadow:8px 8px 0 rgba(0,0,0,.32),inset 0 0 40px rgba(255,255,255,.015);padding:24px}
    .btn{appearance:none;border:2px solid #5a6965;background:#162126;color:var(--ink);padding:15px 20px;min-height:52px;text-transform:uppercase;letter-spacing:2px;font-weight:bold;cursor:pointer;box-shadow:4px 4px 0 #050708;transition:transform .08s,background .1s,border-color .1s}
    .btn:hover,.btn:focus-visible{outline:0;border-color:var(--amber);background:#202e32}
    .btn:active{transform:translate(3px,3px);box-shadow:1px 1px 0 #050708}
    .btn.primary{background:#73521b;border-color:var(--amber);color:#fff4c8}
    .btn.blue{background:#173b49;border-color:var(--blue)}
    .btn.danger{color:#ffaaa0;border-color:#8e4037}
    .btn.small{min-height:40px;padding:9px 14px;font-size:12px}
    .btn:disabled{cursor:not-allowed;opacity:.38;transform:none}
    .menu-wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:50px;align-items:center;height:100%;padding:55px 76px}
    .menu-actions{display:grid;gap:13px}
    .menu-actions .btn{text-align:left;padding-left:28px;font-size:18px}
    .menu-actions .num{display:inline-block;width:34px;color:var(--amber)}
    .feature-list{display:grid;grid-template-columns:repeat(2,1fr);gap:9px;margin-top:24px;color:#b9bea9;font-size:12px}
    .feature-list span:before{content:"◆";color:var(--orange);margin-right:8px}
    .field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 18px}
    .field{display:grid;gap:7px}
    .field label{font-size:11px;color:#b9c0b4;letter-spacing:2px}
    input,select{width:100%;height:48px;border:2px solid #42524f;background:#080d0f;color:var(--ink);padding:0 13px;outline:none}
    input:focus,select:focus{border-color:var(--amber)}
    input[type=range]{accent-color:var(--amber);padding:0;border:0;height:32px;background:transparent}
    .two-column{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:22px}
    .form-actions{display:flex;gap:12px;margin-top:20px;flex-wrap:wrap}
    .back{position:absolute;right:44px;top:34px;z-index:4}
    .notice{min-height:20px;color:var(--amber);font-size:12px;margin-top:12px;letter-spacing:1px}
    .tip-card{border-left:4px solid var(--orange);padding:16px 18px;background:#0b1215;color:#b8c0b4;line-height:1.6;font-size:13px;margin-bottom:12px}
    .rooms{height:210px;overflow:auto;border:2px solid #354541;background:#070b0d;padding:8px}
    .room{display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:12px;padding:12px;border-bottom:1px dashed #35403d;cursor:pointer}
    .room:hover{background:#142024}.room:last-child{border-bottom:0}.room strong{color:var(--amber)}.room small{color:var(--muted)}
    .room-empty{padding:55px 16px;text-align:center;color:#6f7971}
    .lobby-code{font-size:58px;color:var(--amber);letter-spacing:12px;text-align:center;padding:13px;border:2px dashed #786b3e;background:#0a0d0d;margin:18px 0}
    .player-row{display:grid;grid-template-columns:18px 1fr auto auto;gap:12px;align-items:center;padding:10px;border-bottom:1px solid #29332f}
    .swatch{width:14px;height:14px}.tag{border:1px solid #52615c;padding:3px 7px;font-size:10px;color:#b4beb5}.tag.host{border-color:var(--amber);color:var(--amber)}
    #boot{align-items:center;justify-content:center;text-align:center;background:#050708;z-index:1000}
    #boot.active{display:flex}
    #boot .boot-inner{width:720px}
    #boot-logo{font-size:92px;font-weight:bold;letter-spacing:-7px;color:#f3df9c;text-shadow:6px 6px 0 #643116}
    .boot-line{color:#8fa08f;letter-spacing:4px;margin:8px 0 28px}
    .progress{height:18px;border:2px solid #4b5a53;padding:3px}.progress>i{display:block;width:0;height:100%;background:var(--amber);transition:width .18s}
    #boot-ready{margin-top:24px;visibility:hidden;animation:blink 1s steps(2) infinite}
    @keyframes blink{50%{opacity:.25}}
    #battle-screen{z-index:2;background:#000}
    #battle{display:block;width:1280px;height:720px}
    #battle-hud{position:absolute;left:18px;right:18px;top:14px;z-index:4;display:grid;grid-template-columns:250px 1fr 250px;gap:12px;pointer-events:none}
    .hudbox{min-height:62px;background:rgba(5,8,9,.88);border:2px solid #4c5d57;padding:9px 13px;box-shadow:4px 4px 0 rgba(0,0,0,.4)}
    #turn-hud{text-align:center;border-color:var(--amber)}
    #turn-name{font-size:18px;color:var(--amber);font-weight:bold}.hud-label{font-size:10px;color:#94a198;letter-spacing:2px}.hud-main{font-size:17px;margin-top:5px}
    #game-controls{position:absolute;left:18px;right:18px;bottom:14px;z-index:5;display:grid;grid-template-columns:145px 175px 250px 190px 180px 1fr;gap:8px;align-items:end}
    .controlbox{background:rgba(5,8,9,.92);border:2px solid #4c5d57;padding:8px 10px;min-height:74px}
    .controlbox label{display:flex;justify-content:space-between;color:#aeb7ad;font-size:10px;letter-spacing:1px;margin-bottom:4px}
    .controlbox input,.controlbox select{height:35px;font-size:12px;padding:0 7px}
    .fire-group{display:grid;grid-template-columns:1fr 56px;gap:8px}.fire-group .btn{height:74px;font-size:22px;border-color:var(--amber);background:#6c321d}.fire-group .btn:last-child{font-size:17px;background:#192326;border-color:#58645f;padding:0}
    #leave-battle{position:absolute;right:20px;top:92px;z-index:5}
    #scoreboard{position:absolute;left:18px;top:92px;z-index:4;width:275px;background:rgba(5,8,9,.84);border:1px solid #4a5752;padding:8px;pointer-events:none}
    .scoreline{display:grid;grid-template-columns:12px 1fr 27px 38px 32px;gap:6px;font-size:10px;padding:4px 2px;align-items:center}.scoreline.dead{opacity:.42}.scoreline.current{color:var(--amber)}
    #toast{position:absolute;left:50%;top:104px;transform:translateX(-50%);z-index:20;background:#0a0e10;border:2px solid var(--amber);padding:11px 20px;min-width:260px;text-align:center;display:none;box-shadow:5px 5px #000;color:var(--amber)}
    #modal-shade{position:absolute;inset:0;z-index:30;background:rgba(2,4,5,.75);display:none;align-items:center;justify-content:center;padding:35px}
    #modal-shade.visible{display:flex}
    #modal{width:min(900px,100%);max-height:650px;overflow:auto;background:#11191c;border:3px solid var(--amber);box-shadow:14px 14px 0 rgba(0,0,0,.5);padding:28px}
    #modal h2{color:var(--amber)}
    .shop-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:18px 0}
    .shop-card{border:2px solid #3b4a45;background:#0a1012;padding:13px;min-height:125px;display:flex;flex-direction:column;gap:7px}
    .shop-card h4{margin:0;color:#e8dda9;font-size:13px}.shop-card p{font-size:10px;color:#9fa99f;line-height:1.35;flex:1;margin:0}.shop-card .price{color:var(--green);font-weight:bold}.shop-card button{min-height:34px;padding:6px;font-size:10px}
    .manual-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.manual-grid .panel{min-height:155px}.manual-grid p{color:#aeb7ae;line-height:1.55;font-size:13px}
    .key{border:1px solid #5d6c66;background:#090d0e;padding:2px 7px;color:var(--amber)}
    @media(max-width:800px),(orientation:portrait){.shop-grid{grid-template-columns:repeat(2,1fr)}}

    /* ---- Tank Wars 2.5 inspired classic VGA skin ---- */
    :root{
      --dos-blue:#1400eb;--dos-purple:#4d00b2;--dos-gray:#aaa;--dos-dark:#555;
      --dos-white:#fff;--dos-black:#000;--dos-magenta:#aa00aa;--dos-pink:#ff55ff;
      --dos-yellow:#ffff55;--dos-lime:#00ff00;--dos-cyan:#55ffff;--dos-red:#ff5555;
      --dos-sky:#382428;--dos-ground:#00aa00
    }
    html,body{background:#000;color:#000;font-family:"Courier New",monospace;font-weight:700}
    #shell{width:640px;height:400px;background:linear-gradient(#1500eb,#4d00b2);box-shadow:none;image-rendering:pixelated}
    #shell:after{display:none}
    .screen{background:linear-gradient(#1500eb 0%,#2800d7 35%,#4d00b2 100%);color:#000}
    .screen-scroll{padding:8px 14px 18px;font-size:12px}
    .eyebrow{color:var(--dos-yellow);font-size:11px;letter-spacing:1px;margin-bottom:3px}
    h1,h2,h3{font-family:"Courier New",monospace;font-weight:700}
    h2{font-size:24px;color:var(--dos-lime);letter-spacing:0;margin:2px 0 4px}
    h3{font-size:15px;color:#a00;letter-spacing:0}
    .subtitle{color:var(--dos-yellow);font-size:11px;letter-spacing:0;line-height:1.2}
    .rule{height:2px;background:#fff;margin:7px 0}
    .panel,.tip-card{
      background:#aaa;color:#000;border:0;
      box-shadow:inset 3px 3px #fff,inset -3px -3px #555;
      padding:10px
    }
    .tip-card{border-left:0;font-size:11px;line-height:1.25;margin-bottom:8px}
    .tip-card strong{color:#a00}
    .btn,.classic-top-button,.step-btn,.weapon-cell{
      appearance:none;background:#aaa;color:#000;border:0;border-radius:0;
      box-shadow:inset 3px 3px #fff,inset -3px -3px #555;
      text-transform:none;letter-spacing:0;font-weight:700;cursor:pointer;
      font-family:"Courier New",monospace
    }
    .btn{min-height:30px;padding:5px 9px}
    .btn:hover,.btn:focus-visible{background:#aaa;color:#00f;outline:1px solid #fff}
    .btn:active,.classic-top-button:active,.step-btn:active,.weapon-cell:active{box-shadow:inset 3px 3px #555,inset -3px -3px #fff;transform:none}
    .btn.primary{background:#aaa;color:#aa00aa;border:0}
    .btn.blue{background:#aaa;color:#0000ff;border:0}
    .btn.danger{color:#a00;border:0}
    .btn.small{min-height:26px;padding:4px 7px;font-size:11px}
    input,select{
      height:30px;background:#ddd;color:#000;border:0;border-radius:0;padding:0 6px;
      box-shadow:inset 2px 2px #555,inset -2px -2px #fff;font-size:12px
    }
    input:focus,select:focus{outline:1px solid #0000ff}
    input[type=range]{box-shadow:none;background:transparent}
    .field-grid{gap:7px 9px}
    .field{gap:3px}.field label{font-size:10px;color:#600;letter-spacing:0}
    .two-column{grid-template-columns:minmax(0,1fr) 180px;gap:8px}
    .form-actions{gap:6px;margin-top:8px}
    .back{right:10px;top:8px}
    .notice{font-size:10px;color:var(--dos-yellow);margin-top:5px}
    .rooms{height:160px;background:#aaa;border:3px inset #ddd;color:#000}
    .room{padding:7px;border-bottom:1px solid #555}.room:hover{background:#bbb}.room strong{color:#a00}.room small{color:#333}
    .lobby-code{font-size:34px;color:var(--dos-lime);letter-spacing:7px;background:#aaa;border:0;box-shadow:inset 3px 3px #fff,inset -3px -3px #555;margin:8px 0;padding:8px}
    .player-row{padding:6px;border-bottom:1px solid #666}
    .tag{border:1px solid #333;color:#000}.tag.host{border-color:#a00;color:#a00}

    .classic-main{display:block!important;position:relative;height:100%;padding:0}
    .classic-titlebar{
      position:absolute;left:15px;right:15px;top:7px;height:82px;background:#aaa;
      box-shadow:inset 4px 4px #fff,inset -4px -4px #555;overflow:hidden
    }
    .classic-titlebar h1{
      margin:0;padding:5px 34px;font-size:53px;line-height:70px;white-space:nowrap;letter-spacing:-4px;
      color:#ffff55;text-shadow:2px 0 #ff5555,-2px 0 #ff5555,0 2px #ff5555,0 -2px #ff5555
    }
    .classic-titlebar h1 span{margin-left:44px}
    .classic-menu-stack{position:absolute;top:120px;left:230px;width:178px;display:grid;gap:5px;padding:0}
    .classic-menu-label{
      height:39px;background:#aaa;color:#0000aa;display:flex;align-items:center;justify-content:center;font-size:18px;
      box-shadow:inset 3px 3px #fff,inset -3px -3px #555;margin-bottom:1px
    }
    .classic-menu-stack .btn{height:35px;font-size:17px;padding:3px 7px;box-shadow:inset 4px 4px #fff,inset -4px -4px #555}
    .classic-menu-stack .btn:not(.primary){color:#0000ff}
    .classic-menu-stack .btn.primary{color:#aa00aa}
    .classic-secondary{position:absolute;bottom:7px;left:14px;right:14px;display:flex;justify-content:space-between}
    .classic-secondary .btn{min-width:120px;color:#00a}
    #boot{background:linear-gradient(#1500eb,#4d00b2)}
    #boot .boot-inner{width:560px;background:#aaa;padding:20px;box-shadow:inset 4px 4px #fff,inset -4px -4px #555}
    #boot-logo{font-size:64px;letter-spacing:-5px;color:#ffff55;text-shadow:2px 2px #ff5555}
    .boot-line,.eyebrow{color:#a00}.progress{border:2px inset #ddd}.progress>i{background:#00aa00}


    .classic-player-screen{overflow:hidden}
    .local-titlebar{top:7px}
    .classic-player-grid{
      position:absolute;left:15px;right:15px;top:97px;height:241px;
      display:grid;grid-template-columns:repeat(5,1fr);grid-template-rows:repeat(2,1fr);gap:3px
    }
    .classic-player-card{
      min-width:0;background:#aaa;color:#000;box-shadow:inset 3px 3px #fff,inset -3px -3px #555;
      padding:4px 6px 2px;text-align:center;overflow:hidden
    }
    .classic-player-card.inactive{background:#555;box-shadow:none;cursor:pointer}
    .classic-player-name{
      height:23px;line-height:20px;font-size:15px;border-bottom:1px solid #fff;white-space:nowrap;
      cursor:pointer;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none
    }
    .classic-player-card:nth-child(1) .classic-player-name{color:#aa00aa}
    .classic-player-card:nth-child(2) .classic-player-name{color:#aa00aa}
    .classic-player-card.inactive .classic-player-name{color:#000}
    .slot-choice,.slot-toggle{
      display:block;width:100%;height:28px;padding:0;border:0;background:transparent;box-shadow:none;
      font:700 14px/28px "Courier New",monospace;color:#000;cursor:pointer
    }
    .slot-choice.human.selected{color:#5555ff}
    .slot-choice.computer.selected{color:#aa0000}
    .classic-player-card.inactive .slot-choice{color:#000}
    .slot-toggle{font-size:18px;color:#0000aa}
    .classic-player-card.inactive .slot-toggle{color:#000}
    .classic-player-start{
      position:absolute;left:138px;bottom:4px;width:360px;height:54px;background:#aaa;color:#ffff55;border:0;
      box-shadow:inset 4px 4px #fff,inset -4px -4px #555;font:700 38px/50px "Courier New",monospace;
      text-shadow:2px 0 #ff5555,-2px 0 #ff5555,0 2px #ff5555,0 -2px #ff5555;letter-spacing:8px
    }
    .classic-player-options{position:absolute;left:14px;bottom:13px;width:116px;color:#00a}
    .classic-player-back{position:absolute;right:14px;bottom:13px;width:116px;color:#00a}
    .classic-options-panel{
      display:none;position:absolute;inset:0;z-index:30;background:linear-gradient(#1500eb,#4d00b2)
    }
    .classic-player-screen.options-open .classic-options-panel{display:block}
    #battle-screen{background:#382428}
    #battle{
      position:absolute;left:16px;top:57px;width:608px;height:326px;display:block;
      border:3px double #ff55ff;background:#382428;box-sizing:border-box;image-rendering:pixelated
    }
    #battle-hud{
      position:absolute;left:12px;right:12px;top:0;height:35px;display:block;padding:0;background:#382428;
      border:0;z-index:6;pointer-events:none;color:#aa00aa;font-size:16px;line-height:17px
    }
    .hud-row{display:grid;grid-template-columns:1fr 1fr 1fr;white-space:nowrap}
    .hud-row>div:nth-child(2){text-align:center}.hud-row>div:nth-child(3){text-align:right;padding-right:1px}
    .hud-row-1>div:first-child,.hud-row-2>div:first-child{color:#aa00aa}
    .hud-row-1>div:nth-child(2){color:#00ff00}
    .hud-row-1>div:nth-child(3){color:#aa00aa}
    .hud-row-2>div:nth-child(2){color:#5555ff}
    .hud-row-2>div:nth-child(3){color:#aa00aa;padding-right:0}
    #angle-hud-top,#power-hud-top{color:#ffff55}
    #wind-hud{color:#aaa}
    #round-hud{
      position:static;
      width:auto;
      height:auto;
      padding:0 145px 0 0;
      font-size:16px;
      line-height:17px;
      text-align:right;
      background:transparent;
      color:#aa00aa;
      box-shadow:none;
      pointer-events:none
    }
    #weapon-strip{
      position:absolute;left:17px;right:17px;top:35px;height:21px;z-index:8;display:flex;gap:1px;
      background:#000;padding:1px;overflow:hidden
    }
    .weapon-cell{
      flex:1 1 0;min-width:22px;height:19px;padding:0;font-size:12px;line-height:19px;background:#39242a;color:#fff;
      box-shadow:inset 1px 1px #fff,inset -1px -1px #555
    }
    .weapon-cell.selected{background:#39242a;color:#ff2222;box-shadow:inset 2px 2px #fff,inset -2px -2px #555}
    .weapon-cell:disabled{opacity:.42;color:#777}
    .classic-top-button{position:absolute;z-index:12;height:17px;padding:0 4px;font-size:10px}
    #leave-battle{top:18px;right:90px;width:48px;background:#382428;color:#ff55ff;box-shadow:none}
    #battle-more{top:18px;right:17px;width:70px;height:17px;background:#aaa;color:#000}
    #scoreboard{display:none}
    #toast{top:62px;background:#aaa;color:#a00;border:0;box-shadow:inset 3px 3px #fff,inset -3px -3px #555;padding:6px 10px;font-size:11px;min-width:190px}

    #game-controls{position:absolute;inset:0;z-index:11;display:block;pointer-events:none}
    .controlbox{position:absolute;background:#aaa;border:0;padding:4px 5px;min-height:0;box-shadow:inset 3px 3px #fff,inset -3px -3px #555;pointer-events:auto}
    .controlbox label{color:#000;font-size:10px;margin-bottom:2px;letter-spacing:0}
    .controlbox label b{color:#a00}
    .touch-stepper{display:grid;grid-template-columns:1fr 1fr;gap:4px}
    .touch-stepper input{display:none}
    .step-btn{
      height:28px;font-size:18px;
      touch-action:none!important;
      -webkit-user-select:none!important;user-select:none!important;
      -webkit-touch-callout:none!important;
      -webkit-tap-highlight-color:transparent!important;
      -webkit-user-drag:none!important
    }
    .angle-control{left:22px;bottom:9px;width:128px}
    .angle-control .step-btn{height:35px;font-size:23px}
    .power-control{right:154px;bottom:9px;width:102px}
    #battle-screen.controls-locked .angle-control,
    #battle-screen.controls-locked .power-control{
      opacity:.48;
      filter:grayscale(1);
    }
    #battle-screen.controls-locked .angle-control .step-btn,
    #battle-screen.controls-locked .power-control .step-btn{
      background:#777!important;
      color:#333!important;
      box-shadow:inset 1px 1px #999,inset -1px -1px #444!important;
      cursor:not-allowed;
