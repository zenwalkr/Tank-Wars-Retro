  function vgaDrawGeneric(id){vgaGradient();const screen=$(id);if(!screen)return;screen.querySelectorAll('.panel,.tip-card,.rooms,.lobby-code').forEach(el=>{if(!vgaVisible(el))return;const b=vgaElementBox(el);vgaBevel(b.x,b.y,b.w,b.h)});screen.querySelectorAll('input,select').forEach(el=>{if(!vgaVisible(el))return;const b=vgaElementBox(el),val=el.tagName==='SELECT'?(el.options[el.selectedIndex]?.text||''):el.value;vgaInset(b.x,b.y,b.w,b.h,'#dddddd');vgaText(String(val),b.x+2,b.y+Math.max(1,Math.floor((b.h-8)/2)),VGA_COL.black,1,'left',null,Math.max(1,b.w-4),6)});screen.querySelectorAll('button').forEach(el=>{if(!vgaVisible(el))return;const b=vgaElementBox(el);vgaBevel(b.x,b.y,b.w,b.h,VGA_COL.gray,el.matches(':active'));vgaText((el.textContent||'').trim(),b.x+b.w/2,b.y+Math.max(1,Math.floor((b.h-8)/2)),el.classList.contains('primary')?VGA_COL.magenta:VGA_COL.blue,1,'center',null,b.w-4,6)});screen.querySelectorAll('.eyebrow,h2,h3,label,.subtitle').forEach(el=>{if(!vgaVisible(el))return;const b=vgaElementBox(el),t=(el.textContent||'').replace(/\s+/g,' ').trim();if(!t)return;let c=VGA_COL.black,s=1;if(el.matches('.eyebrow'))c=VGA_COL.brown;if(el.matches('h2')){c=VGA_COL.brightGreen;s=2}if(el.matches('h3'))c=VGA_COL.red;if(el.matches('.subtitle'))c=VGA_COL.yellow;vgaText(t,b.x,b.y,c,s,'left',null,Math.min(312-b.x,b.w||312),6)})}

  function makeVgaPalette(){const base=['000000','0000aa','00aa00','00aaaa','aa0000','aa00aa','aa5500','aaaaaa','555555','5555ff','55ff55','55ffff','ff5555','ff55ff','ffff55','ffffff','1500eb','2800d7','4d00b2','382428','39242a','eeeeee','880000','2400db'];const out=[],seen=new Set(),add=h=>{h=h.toLowerCase();if(!seen.has(h)&&out.length<256){seen.add(h);out.push(parseInt(h,16))}};base.forEach(add);for(let i=0;i<32;i++){const q=i/31,r=Math.round(21+(77-21)*q),b=Math.round(235+(178-235)*q);add(r.toString(16).padStart(2,'0')+'00'+b.toString(16).padStart(2,'0'))}const lv=[0,51,102,153,204,255];for(const r of lv)for(const g of lv)for(const b of lv)add(r.toString(16).padStart(2,'0')+g.toString(16).padStart(2,'0')+b.toString(16).padStart(2,'0'));for(let i=0;out.length<256&&i<256;i+=5){const h=i.toString(16).padStart(2,'0');add(h+h+h)}while(out.length<256)out.push(0);return out.slice(0,256)}
  const vgaPalette=makeVgaPalette(),vgaQuantMap=new Uint32Array(4096);for(let key=0;key<4096;key++){const r=((key>>8)&15)*17,g=((key>>4)&15)*17,b=(key&15)*17;let best=0,bd=1e9;for(const c of vgaPalette){const cr=(c>>16)&255,cg=(c>>8)&255,cb=c&255,dr=r-cr,dg=g-cg,db=b-cb,dd=dr*dr+dg*dg+db*db;if(dd<bd){bd=dd;best=c}}vgaQuantMap[key]=best}
  function vgaQuantize(){const im=vga.getImageData(0,0,320,200),d=im.data;for(let i=0;i<d.length;i+=4){const c=vgaQuantMap[((d[i]>>4)<<8)|((d[i+1]>>4)<<4)|(d[i+2]>>4)];d[i]=(c>>16)&255;d[i+1]=(c>>8)&255;d[i+2]=c&255;d[i+3]=255}vga.putImageData(im,0,0)}
  function vgaRender(){vga.setTransform(1,0,0,1,0,0);vga.globalAlpha=1;vga.globalCompositeOperation='source-over';vga.imageSmoothingEnabled=false;const id=vgaActiveScreen();if(id==='main-screen')vgaDrawMain();else if(id==='local-screen'&&!$('local-screen').classList.contains('options-open'))vgaDrawLocal();else if(id==='battle-screen'&&game?.phase==='shop')vgaDrawShop();else if(id==='battle-screen')vgaDrawBattle();else if(id==='boot'){vgaGradient();vgaDrawTitle();vgaBevel(49,109,222,32);vgaText('TANK WARS 2.5',160,116,VGA_COL.yellow,2,'center',VGA_COL.brightRed,9999,6);vgaText(bootN>=100?'PRESS FIRE / CLICK':'LOADING...',160,133,bootN>=100?VGA_COL.brightGreen:VGA_COL.blue,1,'center',null,9999,6)}else vgaDrawGeneric(id);vgaQuantize();setTimeout(()=>requestAnimationFrame(vgaRender),25)}
  requestAnimationFrame(vgaRender);


  addEventListener('beforeunload',()=>{if(mode==='online'&&roomCode)navigator.sendBeacon(API,new URLSearchParams({action:'leave',code:roomCode}))});
})();
