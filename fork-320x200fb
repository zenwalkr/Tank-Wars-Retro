  function fit(){
    const shell=$('shell'),vw=innerWidth,vh=innerHeight;
    const portrait=vh>vw;
    const scale=portrait?Math.min(vh/640,vw/400):Math.min(vw/640,vh/400);
    shell.style.transform=portrait?`translate(-50%,-50%) rotate(90deg) scale(${scale})`:`translate(-50%,-50%) scale(${scale})`;
  }
  addEventListener('resize',fit);fit();

  function dismissSoftKeyboard(){
    const a=document.activeElement;
    if(a&&/^(INPUT|TEXTAREA)$/.test(a.tagName))a.blur()
  }
  function showScreen(id){
    dismissSoftKeyboard();
    document.querySelectorAll('.screen').forEach(s=>s.classList.toggle('active',s.id===id));
    if(id==='battle-screen'){
      requestAnimationFrame(()=>{
        dismissSoftKeyboard();
        try{$('battle-screen').focus({preventScroll:true})}catch(e){$('battle-screen').focus()}
      })
    }
  }
  document.querySelectorAll('[data-go]').forEach(b=>b.addEventListener('click',()=>showScreen(b.dataset.go)));
  function status(id,msg,bad=false){const e=$(id);e.textContent=msg||'';e.style.color=bad?'#ee6352':'#f4d35e'}
  function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
  function clone(v){return JSON.parse(JSON.stringify(v))}
  function actionId(){return Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,9)}
  let localSlotModes=['human','human','off','off','off','off','off','off','off','off'];
  let syncingLocalSlots=false;
  const GAME_PREF_KEY='tankWars25GameCreationOptions';
  const GAME_PREF_IDS=[
    'local-name','local-skill','local-rounds','local-credits','local-terrain','local-background-cycle','local-aim-assist',
    'local-wind','local-teams','local-wind-change','local-gravity','local-drag','local-landslide','local-walls','local-meltdown',
    'host-name','host-max','host-bots','host-skill','host-rounds','host-private','host-terrain','host-background-cycle','host-aim-assist',
    'host-wind','host-teams','host-wind-change','host-gravity','host-drag','host-landslide','host-walls','host-meltdown'
  ];
  function saveGameCreationPrefs(){
    try{
      const fields={};
      for(const id of GAME_PREF_IDS){const el=$(id);if(el)fields[id]=el.value}
      localStorage.setItem(GAME_PREF_KEY,JSON.stringify({fields,localSlotModes:[...localSlotModes]}))
    }catch(e){}
  }
  function loadGameCreationPrefs(){
    try{
      const saved=JSON.parse(localStorage.getItem(GAME_PREF_KEY)||'{}');
      if(saved.fields&&typeof saved.fields==='object'){
        for(const [id,value] of Object.entries(saved.fields)){
          const el=$(id);if(!el)continue;
          if(el.tagName==='SELECT'){
            if([...el.options].some(o=>o.value===String(value)))el.value=String(value)
          }else el.value=String(value)
        }
      }
      if(Array.isArray(saved.localSlotModes)&&saved.localSlotModes.length===10){
        localSlotModes=saved.localSlotModes.map(m=>m==='computer'?'computer':m==='human'?'human':'off');
        if(!localSlotModes.includes('human'))localSlotModes[0]='human'
      }
    }catch(e){}
  }
  function activeLocalCounts(){
    const humans=localSlotModes.filter(m=>m==='human').length;
    const bots=localSlotModes.filter(m=>m==='computer').length;
    return{humans,bots,total:humans+bots};
  }
  function syncQuickMenu(){
    const c=activeLocalCounts(),rd=$('local-rounds');
    if($('quick-players'))$('quick-players').innerHTML=`Players: <span class="vga-menu-number">${c.total}</span>`;
    if($('quick-games')&&rd)$('quick-games').innerHTML=`Games:<span class="vga-menu-number">${rd.value}</span>`;
  }
  function syncSlotsToSelects(){
    const {humans,bots}=activeLocalCounts();
    syncingLocalSlots=true;
    if($('local-humans'))$('local-humans').value=String(Math.max(1,humans));
    if($('local-bots'))$('local-bots').value=String(bots);
    syncingLocalSlots=false;
    syncQuickMenu();
  }
  function rebuildSlotsFromSelects(){
    if(syncingLocalSlots)return;
    const humans=Math.max(1,+($('local-humans')?.value||2)),bots=Math.max(0,+($('local-bots')?.value||0));
    localSlotModes=Array.from({length:10},(_,i)=>i<humans?'human':i<humans+bots?'computer':'off');
    renderLocalPlayerGrid();
    syncQuickMenu();
  }
  function renderLocalPlayerGrid(){
    const grid=$('local-player-grid');if(!grid)return;
    grid.innerHTML=localSlotModes.map((mode,i)=>{
      const active=mode!=='off';
      return `<div class="classic-player-card ${active?'active':'inactive'}" data-slot="${i}">
        <div class="classic-player-name">Player ${i+1}</div>
        <button type="button" class="slot-choice keyboard ${mode==='human'?'selected':''}" data-mode="human">KEYBOARD</button>
        <button type="button" class="slot-choice mouse" data-mode="human">MOUSE</button>
        <button type="button" class="slot-choice computer ${mode==='computer'?'selected':''}" data-mode="computer">COMPUTER</button>
        <button type="button" class="slot-toggle" aria-label="${active?'Disable':'Enable'} player ${i+1}">+</button>
      </div>`;
    }).join('');
    grid.querySelectorAll('.classic-player-name').forEach(name=>name.addEventListener('click',e=>{
      e.stopPropagation();
      const card=name.closest('.classic-player-card'),idx=+card.dataset.slot,was=localSlotModes[idx];
