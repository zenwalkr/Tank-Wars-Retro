  function clearOnlineAimSync(){
    clearTimeout(aimSyncTimer);aimSyncTimer=0;
    pendingOnlineAim=null;localAimOverride=null
  }
  function applyLocalAimOverride(st){
    if(mode!=='online'||!localAimOverride||!st)return;
    const o=localAimOverride;
    if(st.phase!=='playing'||st.currentPlayerId!==o.actorId){
      clearOnlineAimSync();return
    }
    const p=st.players?.find(p=>p.id===o.actorId);
    if(!p?.tank)return;
    p.tank.angle=o.angle;
    p.tank.power=o.power
  }
  function queueOnlineAimSync(){
    if(mode!=='online'||!roomCode||!game||game.phase!=='playing')return;
    const p=current();
    if(!p?.isMe)return;
    const next={
      actorId:p.id,
      angle:Math.max(5,Math.min(175,+$('angle').value||45)),
      power:Math.max(100,Math.min(1000,+$('power').value||600))
    };
    localAimOverride={...next};
    pendingOnlineAim={...next};
    clearTimeout(aimSyncTimer);
    aimSyncTimer=setTimeout(flushOnlineAimSync,70)
  }
  async function flushOnlineAimSync(){
    aimSyncTimer=0;
    if(aimSyncInFlight||!pendingOnlineAim||mode!=='online'||!roomCode)return;
    const payload=pendingOnlineAim;
    pendingOnlineAim=null;
    aimSyncInFlight=true;
    try{
      // Do not apply this response snapshot; regular polling supplies the
      // authoritative state while localAimOverride keeps the turret smooth.
      await netPost({
        action:'aim',
        code:roomCode,
        angle:payload.angle,
        power:payload.power
      },false)
    }catch(e){
      // A turn can legitimately change while a final aim packet is in flight.
      if(!/not your turn|battle is not active/i.test(e.message))console.warn('Aim sync:',e.message)
    }finally{
      aimSyncInFlight=false;
      if(pendingOnlineAim){
        clearTimeout(aimSyncTimer);
        aimSyncTimer=setTimeout(flushOnlineAimSync,20)
      }
    }
  }

